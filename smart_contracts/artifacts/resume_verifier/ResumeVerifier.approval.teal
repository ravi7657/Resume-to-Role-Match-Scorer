// smart_contracts.resume_verifier.contract.ResumeVerifier.register_attestation[routing]() -> void:
register_attestation:
    // smart_contracts/resume_verifier/contract.py:112
    // @abimethod()
    txna ApplicationArgs 1
    dup
    len
    intc_1 // 32
    ==
    assert // invalid number of bytes for arc4.static_array<arc4.uint8, 32>
    txna ApplicationArgs 2
    dup
    intc_2 // 0
    extract_uint16 // on error: invalid array length header
    pushint 2
    +
    dig 1
    len
    ==
    assert // invalid number of bytes for arc4.dynamic_array<arc4.uint8>
    txna ApplicationArgs 3
    dup
    len
    intc_3 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    txn GroupIndex
    intc_0 // 1
    -
    dup
    gtxns TypeEnum
    intc_0 // pay
    ==
    assert // transaction type is pay
    // smart_contracts/resume_verifier/contract.py:153
    // payment.receiver == Global.current_application_address
    dup
    gtxns Receiver
    global CurrentApplicationAddress
    ==
    // smart_contracts/resume_verifier/contract.py:150-154
    // # --- Payment receiver validation ---
    // # The payment MUST go to this specific contract, not any other address.
    // assert (
    //     payment.receiver == Global.current_application_address
    // ), "Payment receiver must be this contract's address"
    assert // Payment receiver must be this contract's address
    // smart_contracts/resume_verifier/contract.py:160
    // payment.amount >= self.min_fee.value
    gtxns Amount
    intc_2 // 0
    bytec_1 // "min_fee"
    app_global_get_ex
    assert // check self.min_fee exists
    dig 1
    <=
    // smart_contracts/resume_verifier/contract.py:156-161
    // # --- Payment amount validation ---
    // # The payment MUST meet the minimum fee set at bootstrap time.
    // # fee_paid stores the real amount from the actual PaymentTxn — not a boolean.
    // assert (
    //     payment.amount >= self.min_fee.value
    // ), "Payment amount is below the minimum attestation fee"
    assert // Payment amount is below the minimum attestation fee
    // smart_contracts/resume_verifier/contract.py:163-164
    // # --- Score range validation ---
    // assert match_score.as_uint64() <= UInt64(100), "Match score must be between 0 and 100"
    dig 1
    btoi
    pushint 100
    <=
    assert // Match score must be between 0 and 100
    // smart_contracts/resume_verifier/contract.py:166-169
    // # --- Construct box key ---
    // # Key = applicant wallet address bytes (32) + resume SHA-256 hash bytes (32) = 64 bytes
    // # This uniquely identifies each (applicant, resume) attestation.
    // box_key = Txn.sender.bytes + resume_hash.bytes
    txn Sender
    uncover 4
    concat
    // smart_contracts/resume_verifier/contract.py:176
    // attestation_round=arc4UInt64(Global.round),
    global Round
    itob
    // smart_contracts/resume_verifier/contract.py:177
    // fee_paid=arc4UInt64(payment.amount),  # Real µALGO from the PaymentTxn — not a flag
    uncover 2
    itob
    // smart_contracts/resume_verifier/contract.py:171-178
    // # --- Write attestation record to Box Storage ---
    // # Overwrites any existing record for this key (safe — allows re-attestation).
    // self.attestations[box_key] = AttestationRecord(
    //     role_id=role_id,
    //     match_score=match_score,
    //     attestation_round=arc4UInt64(Global.round),
    //     fee_paid=arc4UInt64(payment.amount),  # Real µALGO from the PaymentTxn — not a flag
    // )
    pushbytes 0x001a
    uncover 4
    concat
    uncover 2
    concat
    swap
    concat
    uncover 2
    concat
    dig 1
    box_del
    pop
    box_put
    // smart_contracts/resume_verifier/contract.py:112
    // @abimethod()
    pushbytes 0x151f7c7500084154544553544544
    log
    intc_0 // 1
    return


